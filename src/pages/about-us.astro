---
import "../styles/main.scss"
import Layout from "../layouts/Layout.astro";
import Exec from "../components/Exec.astro";
import ExecGroup from "../components/ExecGroup.astro";

import aislyn from "../images/team/Aislyn.png"
import grant from "../images/team/Grant.png"
import alexis from "../images/team/Alexis.png"
import dani from "../images/team/Dani.png"
import mischa from "../images/team/Mischa.png"
// import cameron from "../images/team/Mischa.png"
import andrew from "../images/team/Andrew.png"
import willson from "../images/team/Willson.png"
import isabelle from "../images/team/Isabelle.png"
import isaiah from "../images/team/Isaiah.png"
import aj from "../images/team/AJ.png"
import rebecca from "../images/team/Rebecca.png"
import mikayla from "../images/team/Mikayla.png"
import henry from "../images/team/Henry.png"
import maya from "../images/team/Maya.png"
import sophia from "../images/team/Sophia.png"
import ariya from "../images/team/Ariya.png"
import carolyn from "../images/team/Carolyn.png"
import yusuf from "../images/team/Yususf.png"
import mariepier from "../images/team/Marie-Pier.png"
import rory from "../images/team/Rory.png"

import leo from "../images/team/leo.jpeg"
import sanjana from "../images/team/sanjana.jpeg"
import emilio from "../images/team/emilio.jpg"
import izzy from "../images/team/izzy.jpg"
import terrance from "../images/team/terrance.jpeg"
import jaron from "../images/team/jaron.jpg"




import placeholder from "../images/qsc_circle_outlined.png"
---

<Layout title="About Us">
    <meta slot="head" name="description" property="og:description" content="The Queen's Space Conference (QSC) is an annual space conference held in Kingston, Ontario. The conference is centered around a series of exciting talks from professionals in the space spector, innovative workshops, and networking opportunities. Come to QSC 2025 on Febuary 1st to learn about all things space." />
    <meta slot="head" property="og:url" content="https://www.qsconference.ca/about-us">
    <link slot="head" rel="canonical" href="https://qsconference.com/about-us">

    <main slot="content" class="main">
        <section>
            <h1>About Us</h1>
            <p>The Queen's Space Conference is an annual student-run conference that has taken place every year for over a decade. The QSC executive team is comprised of over a dozen passionate students from different disciplines and backgrounds that come together to provide opportunities for our conference delegates every year. We strive to bring impactful speakers to our conference to deliver enriching presentations and to help students break into the industry by facilitating networking opportunities and connections. Meet our 2025 executive team!</p>
        </section>

        <section>
            <h2>&#8212;2025 Team&#8212;</h2>
            <div class="groups">
                <ExecGroup title="QSC Chairs" email="qsc@engsoc.queensu.ca">
                    <Exec img={isaiah} name="Isaiah Yoder" position="Co-Chair"/>
                    <Exec img={placeholder} name="Hassan Chaudhary " position="Co-Chair" linkedin="https://www.linkedin.com/in/hassan-chaudhary-684894289"/>
                </ExecGroup>

                <ExecGroup title="Logistics Team" email="qsc.logistics@engsoc.queensu.ca">
                    <Exec img={izzy} name="Izzy Kim" position="Logistics Director" linkedin="https://www.linkedin.com/in/izzy-kim-176700180/"/>
                    <Exec img={terrance} name="Terrance Accardi" position="Logistics Coordinator" linkedin="http://linkedin.com/in/terrance-accardi-aa68b8347"/>
                </ExecGroup>

                <ExecGroup title="Finance Team" email="qsc.finance@engsoc.queensu.ca">
                    <Exec img={sanjana} name="Sanjana Sinha" position="Finance Director" linkedin="https://www.linkedin.com/in/sanjana-sinha-b63933319"/>
                    <Exec img={leo} name="Leo Markham" position="Finance Coordinator" linkedin="www.linkedin.com/in/leo-markham"/>
                </ExecGroup>

                { false &&
                <ExecGroup title="Sponsorships Team" email="qsc.sponsorships@engsoc.queensu.ca">
                    <Exec img={andrew} name="Andrew Poltoranos" position="Sponsorships Director"/>
                    <Exec img={willson} name="Willson Bonney" position="Sponsorships Coordinator"/>
                    <Exec img={placeholder} name="Emily Heit" position="Sponsorships Coordinator"/>
                </ExecGroup> }

                { false &&
                <ExecGroup title="Speakers Team" email="qsc.speakers@engsoc.queensu.ca">
                    <Exec img={maya} name="Maya Kerzner" position="Speakers Director"/>
                    <Exec img={sophia} name="Sophia Watson" position="Speakers Coordinator"/>
                    <Exec img={ariya} name="Ariya Gupta" position="Speakers Coordinator" linkedin="https://www.linkedin.com/in/ariya-g-69aa86204/"/>
                </ExecGroup> }

                { false &&
                <ExecGroup title="Delegates Team" email="qsc.delegates@engsoc.queensu.ca">
                    <Exec img={isabelle} name="Carolyn " position="Delegates Director"/>
                    <Exec img={isaiah} name="Isaiah Yoder" position="Internal Delegates Coordinator"/>
                    <Exec img={aj} name="Alexander J.M. Kapty" position="External Delegates Coordinator"/>
                </ExecGroup> }

                <ExecGroup title="Marketing & IT Team" email="qsc.marketing@engsoc.queensu.ca">
                    <Exec img={rory} name="Rory Macdonald" position="Marketing & IT Director" linkedin="https://www.linkedin.com/in/rory-mac"/>
                    <Exec img={yusuf} name="Yusuf Jaffer" position="Marketing Coordinator" linkedin="https://www.linkedin.com/in/yusuf-jaffer-798743293/"/>
                </ExecGroup>

                <ExecGroup title="First Year Reps">
                    <Exec img={emilio} name="Emilio Santos" position="FYR" linkedin="www.linkedin.com/in/emilio-santos-"/>
                    <Exec img={jaron} name="Jaron Cyna" position="FYR" linkedin="https://www.linkedin.com/in/jaron-cyna-67982828a/"/>
                </ExecGroup>

                { false &&
                <ExecGroup title="IT & Web" email="qsc.it@engsoc.queensu.ca" githubLink="https://github.com/QSC">
                    <Exec img={rory} name="Rory Macdonald" position="IT Lead & Webmaster" linkedin="https://www.linkedin.com/in/rory-mac"/>
                </ExecGroup> }
            </div>
        </section>
    </main>
</Layout>
<style lang="scss">
  @use "../styles/fonts";
  @use "../styles/variables" as vars;
  @use "sass:color";

  .main {
    background-image: url("../images/spacebg.png");
    background-attachment: fixed;
    background-size: cover;

    h1 {
      color: color.adjust(vars.$dark-purple, $lightness: 2%);
      font-size: 5em;
      @media screen and (max-width: vars.$screen-mobile-large) {
        font-size: 4em;
      }
    }

    h2 {
      color: color.adjust(vars.$light-purple, $lightness: 3%);
      font-size: 5em;
      text-align: center;
      margin-bottom: .2em;
      @media screen and (max-width: vars.$screen-mobile-large) {
        font-size: 3em;
      }

      @media screen and (max-width: vars.$screen-mobile-medium) {
        font-size: 2.5em;
      }
    }

    .groups {
      display: flex;
      flex-direction: column;
      gap:1.5em;
      padding-bottom: 1em;
    }

    p {
      @media screen and (min-width: vars.$screen-mobile-large) {
        max-width: 75%;
      }
    }

    section:nth-of-type(1) {
      background-color: color.adjust(rgba(vars.$light-purple,80%),$lightness: -2%);
      padding-inline:2em;
      padding-top:1em;
      padding-bottom: 2em;
    }

    section:nth-of-type(2) {
      background-color: rgba(vars.$dark-purple,80%);
    }
  }
</style>