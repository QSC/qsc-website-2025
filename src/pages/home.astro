---
import "../styles/main.scss"
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoImage from "../images/qsc_logo_outlined_cropped_w800.png";
import bg1 from "../images/bg/speaker_1.jpg";
import bg2 from "../images/bg/case_comp.jpeg";
import bg3 from "../images/bg/speaker_2.jpg";
import bg4 from "../images/bg/case_comp_1.jpg";
import bg5 from "../images/bg/speaker_3.jpg";

import locationIcon from "../icons/location.svg"
import calendarIcon from "../icons/calendar.svg"
import speakerIcon from "../icons/speaker.svg"
import networkingIcon from "../icons/networking.svg"
import shuttleIcon from "../icons/space-shuttle.svg"
import astronautIcon from "../images/astronaut_icon.png"

import Question from "../components/Question.astro";
---
<Layout title="Home">
	<meta slot="head" name="description" property="og:description" content="The Queen's Space Conference (QSC) is an annual space conference held in Kingston, Ontario. The conference is centered around a series of exciting talks from professionals in the space spector, innovative workshops, and networking opportunities. Come to QSC 2024 on Febuary 3rd and Febuary 4th to learn about all things space." />
	<meta slot="head" property="og:url" content="https://www.qsconference.ca/home">
	<link slot="head" rel="canonical" href="https://qsconference.com/home">

	<main slot="content">
		<section class="hero">
			<div class="top">
				<div>
					<div class="logoContainer">
						<Image src={logoImage} alt="Queen's Space Conference Logo" style="height: auto; width: 50rem; object-fit: cover";/>
					</div>
					<div class="heroTitleBox">
						<div class="heroTitle">
							<h1>Inspiring; <br/> <span class="light-purple">Educating;</span> <br/> Connecting.</h1>
						</div>
						<div>
							<p>Queen's Space Conference</p>
						</div>
						<div class="tickets">
							{<a href="https://forms.office.com/r/25VtQpeVz2" target="_blank">Buy Tickets</a>}
						</div>
					</div>
				</div>
			</div>
			<div  class="center p-2 mt-1 bottom">
				<div>
					<p class="sem-h-small">Since 2013</p>
					<p class="sem-h-small">QSC</p>
					<p class="sem-h-small">Kingston, Ontario</p>
				</div>
			</div>
		</section>

		<div style="position:relative;" aria-hidden="true">
			<div class="bgs" >
				<Image src={bg1} alt="bg image" style="width: 100%; height: auto; object-fit: contain"/>
				<Image src={bg2} alt="bg image" style="width: 100%; height: auto; object-fit: contain"/>
				<Image src={bg3} alt="bg image" style="width: 100%; height: auto; object-fit: contain"/>
				<Image src={bg4} alt="bg image" style="width: 100%; height: auto; object-fit: contain"/>
				<Image src={bg5} alt="bg image" style="width: 100%; height: auto; object-fit: contain"/>
			</div>

			<section class="about">
				<div class="pl-3 pr-3 pt-2">
					<h2>What is QSC?</h2>

					<div class="p-5 points">
						<div>
							<div>
								<img src={locationIcon.src} alt="an icon of a map pin">
								<img src={calendarIcon.src} alt="an icon of a calendar">
							</div>
							<div>
								<h3>Feb. 1st | Kingston, Ontario</h3>
							</div>
							<div>
								<p>The 2025 Queen's Space Conference will be held on Saturday February 1st, 2025, at the <a href="https://maps.app.goo.gl/nCV8wqfGgg1SWj9S7" target="_blank">Holiday Inn</a>  in downtown Kingston, Ontario. The address is 2 Princess St, Kingston, ON K7L 1A2. The conference will run from approximately 9am-7pm, with meals included in the ticket price.</p>
							</div>
						</div>

						<div>
							<div>
								<Image src={astronautIcon} alt="astronaut"/>
								<img id="podium" src={speakerIcon.src} alt="an icon of speaker at a podium">
							</div>
							<div>
								<h3>Professionals from the Space Industry</h3>
							</div>
							<div>
								<p>We bring <span class="em">industry professionals</span> to our conference in order to provide delegates the most informative, inspiring, and memorable conference possible. Seven speakers will talk about their role in the space industry, their contributions, and where we are headed. Past speakers include CEOs, engineers, astrophysicists, astronauts, AI specialists, and more. Check out our <a href="../speakers">speakers page</a> on this site to look at all of our past speakers over the past 13 years!</p>
							</div>
						</div>

						<div>
							<div>
								<img src={networkingIcon.src} alt="an icon of 3 people">
							</div>
							<div>
								<h3>Networking</h3>
							</div>
							<div>
								<p>We provide networking opportunities with our speakers and their respective organizations, as well as with our cosponsors, other students, and all other delegates. A case competition will be held, where you will be able to collaborate with other delegates to solve a problem presented at the conference. QSC provides a way for you to meet other students, hear their journeys, while also connecting with professionals in the field.</p>
							</div>
						</div>

						<div>
							<div>
								<img class="rotate45" src={shuttleIcon.src} alt="an icon of a map pin">
							</div>
							<div>
								<h3>Blast off!</h3>
							</div>
							<div>
								<p>
									QSC is about sparking thought and idea-generation, connecting our delegates with those who can launch them towards their goals, and spreading education and love for space. QSC is an opportunity to learn, grow, and connect meaningfully. Explore your passions and interests at the Queen's Space Conference.
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>
			<section class="faq">
				<div class="watermark" aria-hidden="true">?</div>
				<div class="pl-3 pt-2">
					<h2>Frequently Asked Questions</h2>
					<div class="p-4">
						<Question question="I have a question that isn't listed here. Who do I ask?">
							Please direct any general inquiries to <a href="mailto:qsc@engsoc.queensu.ca" target="_blank">qsc@engsoc.queensu.ca</a>, or connect with us on our instagram <a href="https://www.instagram.com/queensspace/" target="_blank">@queensspace</a>.
						</Question>
						<Question question="How do I buy tickets?">
							<p>Tickets for QSC 2025 will be for sale soon; in the meantime you can fill out this form and we will email you when tickets go live: <a href="https://forms.office.com/r/25VtQpeVz2" target="_blank">Click here to fill out the form</a></p>
						</Question>
						<Question question="Where is the conference located?">
							<p>The conference is located in Kingston, Ontario! This year the conference will be held at the <a href="https://maps.app.goo.gl/nCV8wqfGgg1SWj9S7" target="_blank">Holiday Inn</a>.</p>
						</Question>
						<Question question="Do you have to be a Queen’s student to come to the conference?">
							<p>No, you do not! Students from everywhere are welcome and encouraged to come to the Queen’s Space Conference.
							</p>
						</Question>
						<Question question="What is a case competition?">
							<p>Case competitions are case studies of tangible, real world scenarios. Delegates will be placed into groups that will work together on solving a proposed issue/problem. Within an allocated time frame, delegates will strive to develop a solution or plan with their team, followed by a presentation at the conference. Case competitions are a fun way to exercise your mind and problem solving abilities while working with other like-minded people, while also competing against other groups. Past case comps have covered topics such as cleaning up space debris, mining asteroids, transporting/synthesizes medicine in space, and more. Some case competitions from QSC 2024 will be posted on the website before QSC 2025, so delegates can get an understanding of what exactly it is!</p>
						</Question>
						<Question question="How can I sponsor QSC?">
							<p>Thank you for considering sponsoring the Queen's Space Conference! Please reach out to <a href="mailto:qsc.sponsorships@engsoc.queensu.ca">qsc.sponsorships@engsoc.queensu.ca</a> for more information.</p>
						</Question>
					</div>
				</div>
			</section>
		</div>
	</main>
</Layout>
<style lang="scss">
	@use "../styles/fonts" as fonts;
	@use "../styles/variables" as vars;
	@use "sass:color";

	$about-bg: rgba(vars.$dark-purple, 90%);
	$faq-bg: rgba(vars.$light-purple, 80%);

	main:has(.hero) {
		background-image: url("../images/spacebg.png");
		background-attachment: fixed;
		background-size: cover;
	}

	.hero {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: calc(100vh - var(--navbar-height));
		overflow: hidden;
		position:relative;

		>* {
			z-index: 1;
		}
		.top {
			display: flex;
			flex-direction: row;
			justify-content: center;
			flex-basis: 100%;
			flex-grow: 1;
		}

		.top > div {
			display: flex;
			flex-direction: row;
			flex-basis: 100%;
			justify-content: space-evenly;
			gap: 3rem;
			align-items: center;
			flex-wrap: wrap;

			@media screen and (max-width: vars.$screen-mobile-large) {
				justify-content: center;
			}

			.logo-container {
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.heroTitleBox {
				.heroTitle {
					display: flex;
					align-items: center;
					justify-content: center;
					position: relative;
					h1 {
						@media screen and (max-width: vars.$screen-mobile-large){
							font-size: 4rem;
							line-height: 2em;
						}
					}
				}
				.tickets {
					color: vars.$light-purple;
					margin-top: 1em;
					a {
						font-size: 2.5em;
						background-color: rgba(vars.$dark-purple, 40%);
						font-family: fonts.$quicksand;
						font-weight: fonts.$regular-weight;
						border: .5rem solid rgba(vars.$light-purple, 80%);
						border-radius: 1rem;
						padding-inline: .3em;
						text-decoration: none;
						color:inherit;
						font-weight: fonts.$heavy-weight;
					}
					a:hover, a:focus {
						color: vars.$white;
						background-color: rgba(color.adjust(vars.$dark-purple, $lightness:10%), 40%);
						border-color: vars.$white;
					}
				}
			}
		}

		.bottom {
			background-color: rgba(vars.$light-purple, 40%);
			padding: 1em;
			padding-inline: 2em;
			display: flex;
			justify-content: center;
			align-items: center;

			div {
				display: flex;
				font-size: 2.5rem;
				font-weight: fonts.$heavy-weight;
				flex-grow: 1;
				justify-content: center;

				> * {
					margin: 0 auto;
				}
				@media screen and (max-width: vars.$screen-mobile-large) {
					flex-direction: column;
				}
			}
		}

		@media screen and (max-width: vars.$screen-mobile-large) {
			img {
				display: none;
			}
		}

		@media screen and (max-width: vars.$screen-desktop) {
			* {
				text-align: center;
			}
		}
	}

	// black to cover the bg image to make text readable
	.hero::before {
		position: absolute;
		top: 0;
		left: 0;
		width:100%;
		height:100%;
		background-color: rgba(0 0 0 / .30);
		z-index: 0;
		content:"";
	}

	.bgs {
		position: absolute;
		overflow:hidden;
		z-index: 0;
		max-height: 100%;

		* {
			display:block;
		}
	}

	.about {
		position: relative;
		margin: 0;
		background-color: $about-bg;
		//background: linear-gradient(to bottom, $about-bg 95%, $faq-bg 100%);

		a {
			color: color.adjust(vars.$orange,$lightness:9%);
			font-weight: fonts.$medium-weight;

		}
		a:hover {
			color: vars.$white;
		}

		.points {
			--l-padding: 2rem;
			display: flex;
			flex-direction: column;
			gap: 1em;
			align-items: center;

			> div {

			}

			h3 {
				font-family: fonts.$quicksand;
				font-weight: fonts.$regular-weight;
				margin-left: var(--l-padding);
				margin-bottom: .1em;
				@media screen and (max-width: vars.$screen-mobile-large) {
					text-align: center;
					margin-left: 0;
				}
			}

			div:has(> img) {
				display: flex;
				justify-content: left;
				align-items: center;
				padding: 1rem;
				gap: 2rem;
				margin-left: var(--l-padding);
				@media screen and (max-width: vars.$screen-mobile-large) {
					justify-content: center;
					margin:0;
				}
			}

			//div with the map and calendar
			div:has(> img) {
				img {
					height: 8rem;
					width: auto;
				}
			}

			div:has(>p) {
				p {
					padding: var(--l-padding);
					background-color: rgba(color.adjust(vars.$light-purple, $lightness: -2%), 60%);
					border-radius: 15px;
					max-width:80%;

					.em {
						color: vars.$orange;
						font-weight: fonts.$heavy-weight;
					}
				}
				@media screen and (max-width: vars.$screen-mobile-large) {
					display:flex;
					justify-content: center;
				}
			}
		}
	}

	.faq {
		background-color: $faq-bg;
		//background: linear-gradient(to bottom, $about-bg 5%, $faq-bg 10%);
		position: relative;
		z-index: 0;
		overflow: hidden;

		div:nth-child(2) {
			position:relative;
		}

		* {
			z-index: 2;
		}

		.watermark {
			font-size: 50rem;
			position: absolute;
			font-weight: fonts.$medium-weight;
			font-family: fonts.$inter;
			top:-15rem;
			left:-5rem;
			line-height: 1em;
			z-index: 1;
			color: rgba(color.adjust(vars.$dark-purple, $lightness: 6%), 80%);
		}

		*:has(>faq-question) {
			display: flex;
			flex-direction: column;
			gap: 3rem;

			@media screen and (max-width: vars.$screen-mobile-large) {
				//  align-items: center;
			}
		}
	}

	section {
		display: block;
		margin: 0;
		padding: 0;
	}
</style>